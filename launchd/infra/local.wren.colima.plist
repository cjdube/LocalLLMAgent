<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Replaces Homebrew's homebrew.mxcl.colima service.

  Homebrew's plist gives up permanently after one failed start:

      <key>KeepAlive</key>
      <dict><key>SuccessfulExit</key><true/></dict>

  which means "relaunch only if it exited SUCCESSFULLY". colima exited 1 after
  the Jul 11 2026 reboot, so launchd never retried and Wren's push channel was
  down for four days. KeepAlive=true below means "keep this running, full stop"
  — the actual contract for a service that's meant to always be up.

  colima-start.sh clears the stale instance state first; without it a retry
  would just re-run the same failing command every 60s forever.

  This lives OUTSIDE launchd/ proper (in launchd/infra/) on purpose:
  chat/insights.py:discover_tasks globs launchd/*.plist non-recursively, so
  keeping it a directory down means colima doesn't show up as a Wren task in
  the dashboard.

  Install (the paths below are __WREN_ROOT__/__HOME__ placeholders — install.sh
  fills them in, so don't cp this file into place by hand):
      brew services stop colima     # hand off from Homebrew first
      ./launchd/install.sh launchd/infra/local.wren.colima.plist

  To stop colima deliberately, boot it out — `colima stop` alone won't stick,
  because launchd will bring it straight back:
      launchctl bootout gui/$(id -u)/local.wren.colima
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.wren.colima</string>

    <key>ProgramArguments</key>
    <array>
        <string>__WREN_ROOT__/launchd/infra/colima-start.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__HOME__</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Always up. Unlike Homebrew's SuccessfulExit=true, this retries after a
         FAILED start too — the case that actually took ntfy down. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Don't hot-loop if colima is genuinely broken; the VM takes ~20s to boot
         anyway, so a 60s floor between attempts costs nothing. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/opt/homebrew/var/log/colima.log</string>
    <key>StandardErrorPath</key>
    <string>/opt/homebrew/var/log/colima.log</string>
</dict>
</plist>
