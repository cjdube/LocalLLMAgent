<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.wren.remindersweep</string>

    <key>ProgramArguments</key>
    <array>
        <string>__WREN_ROOT__/.venv/bin/python</string>
        <string>-m</string>
        <string>tasks.reminder_sweep</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__WREN_ROOT__</string>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>__WREN_ROOT__/logs/reminder_sweep.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__WREN_ROOT__/logs/reminder_sweep.launchd.log</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
