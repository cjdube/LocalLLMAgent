<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.scribejay.dailyyoutubelearnings</string>

    <key>ProgramArguments</key>
    <array>
        <string>__WREN_ROOT__/.venv/bin/python</string>
        <string>-m</string>
        <string>scribejay.daily_youtube_learnings</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__WREN_ROOT__</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>5</integer>
        <key>Minute</key>
        <integer>5</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__WREN_ROOT__/logs/daily_youtube_learnings.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__WREN_ROOT__/logs/daily_youtube_learnings.launchd.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
