<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.wren.startuprecovery</string>

    <key>ProgramArguments</key>
    <array>
        <string>__WREN_ROOT__/.venv/bin/python</string>
        <string>-m</string>
        <string>tasks.startup_recovery</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__WREN_ROOT__</string>

    <!-- The runner advances one queued task per poll, never a fan-out. -->
    <key>StartInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>__WREN_ROOT__/logs/startup_recovery.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__WREN_ROOT__/logs/startup_recovery.launchd.log</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
