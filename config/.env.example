OPENWEATHERMAP_API_KEY=your_openweathermap_key_here
# Strava API app (https://www.strava.com/settings/api). Get the refresh token
# once via: python -m agent.tools.strava --authorize
STRAVA_CLIENT_ID=your_strava_client_id_here
STRAVA_CLIENT_SECRET=your_strava_client_secret_here
STRAVA_REFRESH_TOKEN=your_strava_refresh_token_here
TAVILY_API_KEY=your_tavily_api_key_here
# Firecrawl (https://www.firecrawl.dev/ — free key) — powers fetch_webpage and
# evaluate_app: fetches a page's readable content as markdown.
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
# Optional: cap (chars) on the markdown fetch_webpage returns. Defaults to
# 14000. Raising it needs a matching raise of fetch_webpage's entry in
# loop.TOOL_RESULT_CHAR_CAPS (16000) — the gap between them is wrapper room,
# and closing it means the loop re-cuts a page the tool already cut.
# WEB_FETCH_MAX_CHARS=14000

# GitHub personal access token — a classic PAT with no scopes works for
# public starred repos; add the "repo" (read) scope to include private stars.
GITHUB_TOKEN=your_github_pat_here

# LLM backend selection. Default is local Ollama (the local-first design); set
# to "gemini" to route the model calls to Google's cloud instead. NOTE: a cloud
# backend sends tool results + conversation history off-device — the opposite of
# the local-first default — so switch deliberately.
# WREN_LLM_BACKEND=ollama
# Per-task override: WREN_<TASK_KEY>_BACKEND wins over the global WREN_LLM_BACKEND
# for one task only. Lets chat + bg_worker stay local (on the global default)
# while an individual scheduled summarizer uses the cloud. Task keys match the
# task module names. The full list of wired keys is in docs/llm-backend.md; a
# WREN_<ANYTHING>_BACKEND that matches no call site is silently inert rather
# than an error. Examples:
# WREN_DAILY_SYNTHESIS_BACKEND=gemini
# WREN_OPPORTUNITY_DIGEST_BACKEND=gemini
# WREN_STARRED_BLURBS_BACKEND=gemini
# WREN_EVALUATE_AGAINST_BACKEND=gemini
# Frontier backend for chat's manual "redo with the frontier model" button
# (docs/frontier-escalation.md). Its OWN variable, not WREN_LLM_BACKEND: the
# global default is ollama, which names no frontier target. Unset → the button
# is hidden. Provider-neutral — set to any backend whose adapter exists (today:
# gemini). The target provider's key must also be present or the button stays
# hidden.
# WREN_ESCALATION_BACKEND=gemini

# Scribe — the journaling agent (scribe/) — resolves its own backend and never
# reads the WREN_* variables: SCRIBE_<TASK_KEY>_BACKEND, then SCRIBE_LLM_BACKEND,
# then ollama. Separate on purpose. The chrome/youtube compaction caps are sized
# for a cloud model, so a silent fall-through to the local model would drop whole
# sections out of the draft instead of erroring; an unset variable resolving to
# ollama is logged on the first line of every Scribe run. Task keys match the
# scribe/ module names. See docs/scribe.md.
# SCRIBE_LLM_BACKEND=ollama
# SCRIBE_DAILY_CHROME_LEARNINGS_BACKEND=gemini
# SCRIBE_DAILY_YOUTUBE_LEARNINGS_BACKEND=gemini
# SCRIBE_AI_CHAT_LEARNINGS_BACKEND=gemini
# SCRIBE_CLAUDE_TIME_BLOCKS_BACKEND=gemini
# SCRIBE_CALENDAR_COLORIZER_BACKEND=gemini
# Gemini key — GEMINI_API_KEY or GOOGLE_API_KEY both work (the SDK checks both).
# Set either one, not both; GEMINI_API_KEY wins if you do.
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# Cloud model id when WREN_LLM_BACKEND=gemini. Defaults to gemini-2.5-flash.
# WREN_GEMINI_MODEL=gemini-2.5-flash
# Optional: cap on tokens the cloud model generates per call. Defaults to 8192.
# WREN_GEMINI_MAX_OUTPUT_TOKENS=8192
# Gemini thinking-token budget. 0 is the code default. Two things it is NOT:
#   * Not a cap. On the 3.x models the budget is a hint the model overruns —
#     measured 2026-08-16, gemini-3.7-flash spent 268-313 thinking tokens at a
#     budget of 0, and both 3.6 and 3.7 overran a budget of 128. What actually
#     protects the visible draft is WREN_GEMINI_MAX_OUTPUT_TOKENS above:
#     thinking counts against it, and at 200 the thinking ate 194 and returned
#     3 characters. The 8192 default leaves ample room.
#   * Not portable. 0 works on gemini-2.5-flash and gemini-3.7-flash, but
#     gemini-2.5-pro and gemini-3.6-flash reject it with a bare 400
#     INVALID_ARGUMENT. 128 (or -1 for dynamic) is accepted everywhere, which
#     is why it is pinned here — it also survives a rollback to 3.6.
# Verify with one real call after changing WREN_GEMINI_MODEL either way.
# WREN_GEMINI_THINKING_BUDGET=128

# Ollama
OLLAMA_MODEL=gemma4
OLLAMA_HOST=http://localhost:11434
# HTTP read timeout (seconds) for a single Ollama chat call. Calls stream, so
# this is the gap allowed BETWEEN chunks, not a cap on total generation: it has
# to cover the wait for the first token (prefill of a large batch prompt runs
# ~50s), after which a healthy stream keeps the socket fed. Defaults to 300.
OLLAMA_TIMEOUT=300
# Optional: the same read timeout for INTERACTIVE chat turns, kept tighter than
# OLLAMA_TIMEOUT because someone is waiting on the answer. Ollama serves one
# request at a time (OLLAMA_NUM_PARALLEL defaults to 1) and queues the rest
# silently, so a turn stuck behind a long background job just goes quiet — on
# 2026-08-03 that meant a five-minute spinner and a misleading "connection
# failed". Wren now probes /api/ps on timeout and reports the real cause.
# Defaults to 120.
# WREN_CHAT_MODEL_TIMEOUT=120
# Context window (tokens) requested per chat call. Ollama otherwise falls back
# to a small default (~4096) and silently truncates the FRONT of the prompt —
# where Wren's system prompt lives. 8192 gives headroom for the personas +
# memory + ~13 tool schemas + a few wiki-page reads. Defaults to 8192 if unset.
OLLAMA_NUM_CTX=8192
# Optional: cap on tokens generated per model call. A runaway repetition loop
# (a small-model failure mode) otherwise burns thousands of junk tokens that
# then pollute the session history. Keep it comfortably above the longest
# legitimate reply (~2200 tokens for an app teardown). Defaults to 3072.
# OLLAMA_NUM_PREDICT=3072
# Optional: how long Ollama keeps the model resident after a call. Keeping the
# large model warm between the day's scheduled tasks avoids re-paying the
# ~17GB cold-load. Accepts a duration ("30m") or -1 to pin. Defaults to 30m.
# OLLAMA_KEEP_ALIVE=30m
# Optional: timeout (seconds) for the warm_model() preload that scheduled tasks
# run before a big generation, so the cold model load gets its own budget
# instead of eating into the generation's read timeout. Defaults to 600.
# OLLAMA_WARM_TIMEOUT=600
# Optional: cap on a single tool result before it's appended to the chat
# (chars, ~4 chars/token). Defaults to 8000 if unset.
# OLLAMA_MAX_TOOL_RESULT_CHARS=8000
# Optional: budget for the chat conversation history re-sent to the model each
# turn (chars). When a session exceeds it, the oldest whole user-turns are
# dropped (system prompt and newest turn always kept) so the prompt never
# reaches OLLAMA_NUM_CTX and loses the front of the conversation. The default
# of 16000 (~4k tokens) suits the default 8192 window; raise them together.
# Trimming only bounds the history *between* turns — a turn's tool results pile
# on top of it — so the real ceiling is this + (10 x OLLAMA_MAX_TOOL_RESULT_CHARS)
# + the prompt head. The head is the part with no knob: the system message, the
# summary below, and every tool schema, ~48,000 chars as of 2026-08-26 and
# growing with each tool registered. It is usually the LARGEST of the three, so
# sizing OLLAMA_NUM_CTX against this variable alone will under-size it.
# The chat server measures all three at startup and logs + pushes a warning if
# the total can overflow OLLAMA_NUM_CTX, so a raise here without a matching
# num_ctx raise doesn't silently truncate the system prompt. docs/limits.md
# WREN_CHAT_MAX_HISTORY_CHARS=16000
# Optional: cap on the running summary that replaces the dropped turns (chars).
# Before evicting them the server has the model compact them into notes, which
# ride in the system message — the one slot the trim never drops — so a long
# session forgets the wording of its early turns rather than their substance.
# It is spent out of the history budget above, so a large value crowds out the
# live conversation. Defaults to 1500. Set it to 0 to go back to plain dropping.
# WREN_CHAT_SUMMARY_CHARS=1500

# Google Calendar / Gmail / Tasks (OAuth)
GOOGLE_CREDENTIALS_PATH=config/google_credentials.json
GOOGLE_TOKEN_PATH=config/google_token.json
GOOGLE_CALENDAR_ID=primary
# Optional: outbound timeout (seconds) for Google API calls. Defaults to 30.
# GOOGLE_HTTP_TIMEOUT_S=30
# Optional: pin the port the one-time consent flow listens on. Defaults to 0,
# meaning a random port. Set it when consenting from another machine over SSH —
# the browser there resolves "localhost" to itself, so the callback only arrives
# through `ssh -L <port>:localhost:<port> wren`, and a tunnel needs a fixed port.
# GOOGLE_OAUTH_PORT=8765
# Optional: scope Google Tasks reads (and new-task creation without an
# explicit list) to a single list id. Unset by default, which reads across
# every task list on the account — get_tasks/get_tasks_due_soon aggregate
# them all since tasks are commonly spread across several named lists.
# GOOGLE_TASKLIST_ID=some_task_list_id_here
# Optional: timezone used when creating calendar events. Defaults to the system
# zone (resolved from /etc/localtime). Must be a full IANA name like
# America/New_York — Google Calendar rejects abbreviations such as EDT.
# TIMEZONE=America/New_York

# Morning brief recipient
BRIEF_TO_EMAIL=you@example.com

# Default location for weather. Optional — if unset, falls back to
# "location" in config/preferences.json.
# DEFAULT_LOCATION=Portland,OR,US

# Optional: where chat skills (reusable procedures) are stored, one Markdown
# file per skill. Defaults to the repo's skills/ directory if unset.
# WREN_SKILLS_DIR=/path/to/skills

# Daily learnings — directory the daily review Markdown files are written to
# (one file per day). Defaults to ~/Vaults/llm-wiki-learnings/raw if unset.
LEARNINGS_DIR=~/Vaults/llm-wiki-learnings/raw

# Daily synthesis (tasks/daily_synthesis.py) — where the dated nudge archive is
# written. Must NOT be LEARNINGS_DIR: raw/ is ObsidianWikiAgent's ingest queue,
# and a nudge ("is this worth adding?") ingested as a source becomes a fabricated
# wiki claim. Defaults to ~/Vaults/llm-wiki-learnings/nudges if unset. The dir
# must exist — a missing one emails the nudges instead of creating a stray tree.
SYNTHESIS_DIR=~/Vaults/llm-wiki-learnings/nudges

# Learnings wiki — root of the Obsidian vault Wren reads to answer "what did I
# decide about X" (raw/ daily reviews + wiki/ concept pages built by
# ObsidianWikiAgent). Defaults to ~/Vaults/llm-wiki-learnings if unset.
#
# Keep the vault out of ~/Documents, ~/Desktop and ~/Downloads. Those are
# TCC-protected, and a launchd-spawned job has no session to show the consent
# prompt in — so it blocks on a dialog nobody sees instead of failing. That is
# what moved the vault here on 2026-08-14; don't move it back.
WIKI_VAULT_PATH=~/Vaults/llm-wiki-learnings

# External task roots — sibling repos whose launchd jobs the dashboard, the run
# charts, /map and log_inspector report on alongside Wren's own. Comma-separated
# `name=path`; the name prefixes each task key ("wiki-learnings-ingest"). Those
# jobs are report-only — no "Run now" button — because they aren't Wren's to
# spawn and the wiki ingest can hold the single Ollama slot for hours. Unset
# means Wren's own tasks only. See docs/external-tasks.md.
WREN_EXTERNAL_TASK_ROOTS=wiki=~/Projects/ObsidianWikiAgent

# Wiki lint repo — the ObsidianWikiAgent checkout /wiki/lint shells out to. That
# repo owns the audit; Wren runs `wiki_lint.py --vault <WIKI_VAULT_PATH> --json`
# with the checkout's OWN .venv interpreter and renders the result. It is a
# subprocess and never an import: both repos have a top-level `agent` package.
# Usually the same path as the external task root above, but kept separate — one
# names a repo whose logs are read, the other a repo whose code is run. Missing
# or without a virtualenv means the view says so; nothing else breaks.
# Defaults to ~/Projects/ObsidianWikiAgent if unset. See docs/wiki-lint.md.
# WREN_WIKI_LINT_ROOT=~/Projects/ObsidianWikiAgent

# Project registry (tasks/project_scan.py) — where your local checkouts live.
# Each direct subdirectory is scanned for git freshness plus its README,
# CLAUDE.md and docs/ headings, and nothing else — never .env or any other file
# that happens to sit in a project dir. Feeds daily_synthesis anchors, so the
# day's reading can be matched against what you're actually building. Defaults
# to ~/Projects if unset.
# PROJECTS_DIR=~/Projects

# AI chat learnings (scribe/ai_chat_learnings.py) — daily summary of the prior
# day's AI-agent chats, written to LEARNINGS_DIR. Claude Code sessions are read
# from ~/.claude/projects automatically; Gemini has no API for past chats, so
# drop exported Gemini conversations (.md/.txt/.json, one per chat) into this
# folder and they're summarized once each. Defaults to <vault>/gemini_inbox.
# WREN_GEMINI_CHATS_DIR=~/Vaults/llm-wiki-learnings/gemini_inbox
# Per-session transcript char cap fed to the model (bounds the prompt). Default 12000.
# AI_CHAT_LEARNINGS_MAX_CHARS=12000
# Runs on the local model by design; override with SCRIBE_AI_CHAT_LEARNINGS_BACKEND.

# Claude Code time blocks (scribe/claude_time_blocks.py) — logs yesterday's Claude
# Code working hours to Google Calendar. Reads the same ~/.claude/projects logs.
# Idle gap that ends a block; tuned against real days (10 fragments, 30 over-merges).
# WREN_SESSION_BLOCK_GAP_MINUTES=20
# Blocks shorter than this are dropped — a glance isn't a calendar entry.
# WREN_SESSION_BLOCK_MIN_MINUTES=10
# Per-block transcript char cap fed to the model (bounds the prompt). Default 6000.
# WREN_SESSION_BLOCK_MAX_CHARS=6000
# Runs on the local model by design; override with SCRIBE_CLAUDE_TIME_BLOCKS_BACKEND.

# Phone push alerts on scheduled-task failure (agent/tools/notify.py) via a
# self-hosted ntfy server. Optional — leave NTFY_URL unset to disable push.
# NTFY_URL is the full topic URL; NTFY_TOKEN is a publish token for it.
# See the "ntfy push server" step in the README setup.
NTFY_URL=http://mac-mini-tailscale-name:2586/wren-alerts
NTFY_TOKEN=tk_your_publish_token_here

# Opportunity scout (tasks/opportunity_digest.py) — weekly digest of
# fractional-work signals. All optional; defaults shown.
# States whose new SEC Form D filings count as a "just funded" signal.
# If unset, falls back to job_search.states in config/preferences.json.
# OPP_STATES=MA,NH,ME
# Days a watched leadership opening stays open before it's flagged stalled.
# OPP_STALLED_DAYS=45
# Minimum model score (1-10) that triggers an ntfy push on top of the email.
# OPP_SCORE_THRESHOLD=8

# Directory for the structured per-task logs. Leave unset in production: it
# defaults to logs/ at the repo root, which is what launchd and the insights
# page expect. The test suite sets it to a tmp dir (tests/conftest.py) so a
# child interpreter spawned by a test can't append fixture rows to real logs.
# WREN_LOGS_DIR=

# Wren chat server (chat/server.py) — only reachable over Tailscale, never
# the open internet, but these still gate who can use it.
# Generate both with: python -c "import secrets; print(secrets.token_hex(32))"
WREN_CHAT_TOKEN=generate_a_long_random_token_here
FLASK_SECRET_KEY=generate_a_different_long_random_value_here
WREN_CHAT_PORT=8420
# Bind address. Defaults to 127.0.0.1 (loopback), which is all `tailscale serve`
# needs. Only widen this (e.g. 0.0.0.0) if you know you need a direct LAN bind.
# WREN_CHAT_HOST=127.0.0.1
# Public HTTPS base URL of the chat server over Tailscale (from `tailscale
# serve`). Used to build the tap-to-approve buttons on background-task approval
# pushes, and the tappable game links list_games hands back. If unset, approval
# pushes still arrive but without buttons, and game links are bare paths.
WREN_PUBLIC_URL=https://mac-mini-tailscale-name.ts.net

# --------------------------------------------------------------------------- #
# Gmail push notifications (see docs/mail-watch.md)
# --------------------------------------------------------------------------- #
# Wren is told the moment mail carrying a label arrives. Gmail publishes the
# change to a Cloud Pub/Sub topic; tasks/mail_watcher.py holds a streaming-pull
# subscription on it, so nothing listens on a port.
#
# Required. The Google Cloud project holding the topic — the same project as
# config/google_credentials.json. Unset, both mail tasks refuse to start.
# MAIL_PUBSUB_PROJECT=your-gcp-project-id
# The Pub/Sub topic Gmail publishes to, and the PULL subscription on it.
# Defaults shown; both must already exist in the console.
# MAIL_PUBSUB_TOPIC=wren-mail
# MAIL_PUBSUB_SUBSCRIPTION=wren-mail-sub
# The Gmail label that decides which mail Wren is told about. Create it in
# Gmail, with a filter that applies it. Nested from the start, so sibling
# labels can be added later without rebuilding this one. Wren looks the label's
# internal id up from this name — never configure the id by hand.
# MAIL_WATCH_LABEL=Wren/Watch
# The label that means "handle this", not just "tell me". Mail on a thread
# carrying it becomes a background job with the model's tools available, so
# everything outside toolset.MAIL_JOB_SAFE_TOOLS pauses for a tap on the phone.
# Optional: skip creating it in Gmail and the watcher runs watch-only, saying so
# in the log. Note a Gmail label applies to the whole THREAD, so every later
# reply on that thread is handed to Wren too — peel it off when the thing is
# done. See docs/mail-watch.md.
# MAIL_ACT_LABEL=Wren/Do
# How much of one email body is kept. A raw email runs to tens of thousands of
# characters and the on-device model's whole context is 32k, so this is trimmed
# at the source rather than by the tool-result backstop.
# MAIL_BODY_CHAR_BUDGET=1500
# Size caps on what the mail tools hand the model: a whole thread (read_email)
# and a page of search results (search_mail). Both sit under the per-tool caps
# in agent/loop.py's TOOL_RESULT_CHAR_CAPS — raise them as a pair or the loop
# re-trims a result the tool already trimmed on purpose.
# MAIL_THREAD_CHAR_BUDGET=12000
# MAIL_SEARCH_CHAR_BUDGET=6000

# --------------------------------------------------------------------------- #
# Games (see docs/games.md)
# --------------------------------------------------------------------------- #
# Weigh Anchor lives in its own repo; Wren serves its built bundle at
# /games/weigh-anchor/ and proxies the AI calls to its local service. Both
# default to the values below, so neither is required unless you moved the
# checkout or the port is taken.
# WEIGH_ANCHOR_DIR=~/Projects/WeighAnchor
# Must match PORT in launchd/infra/local.wren.weighanchor.plist.
# WEIGH_ANCHOR_PORT=3002
