OPENWEATHERMAP_API_KEY=your_openweathermap_key_here
COMPOSIO_API_KEY=your_composio_api_key_here
STRAVA_USER_ID=your_strava_user_id_here
STRAVA_CONNECTED_ACCOUNT_ID=your_connected_account_id_here

# Ollama
OLLAMA_MODEL=gemma4
OLLAMA_HOST=http://localhost:11434

# Google Calendar / Gmail (OAuth)
GOOGLE_CREDENTIALS_PATH=config/google_credentials.json
GOOGLE_TOKEN_PATH=config/google_token.json
GOOGLE_CALENDAR_ID=primary

# Morning brief recipient
BRIEF_TO_EMAIL=you@example.com

# Default location for weather
DEFAULT_LOCATION=Newfields,NH,US

# Weekly Learning & Project Log (Google Doc)
WEEKLY_LOG_DOC_ID=your_google_doc_id_here

# Wren chat server (chat/server.py) — only reachable over Tailscale, never
# the open internet, but these still gate who can use it.
# Generate both with: python -c "import secrets; print(secrets.token_hex(32))"
WREN_CHAT_TOKEN=generate_a_long_random_token_here
FLASK_SECRET_KEY=generate_a_different_long_random_value_here
WREN_CHAT_PORT=8420
